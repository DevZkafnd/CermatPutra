# Environment Variables Template
# Copy file ini menjadi .env dan sesuaikan valuenya

# Database
POSTGRES_USER=ecommerce_user
POSTGRES_PASSWORD=ganti_dengan_password_aman
POSTGRES_DB=ecommerce_db
DATABASE_URL=postgresql://ecommerce_user:ganti_dengan_password_aman@db:5432/ecommerce_db?schema=public

# Backend
BACKEND_PORT=3001
NODE_ENV=development
JWT_SECRET=ganti_dengan_secret_key_yang_aman

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Payment Gateway (Midtrans)
MIDTRANS_SERVER_KEY=your_midtrans_server_key_here
MIDTRANS_CLIENT_KEY=your_midtrans_client_key_here
MIDTRANS_IS_PRODUCTION=false

# Google Maps API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# CORS
ALLOWED_ORIGINS=http://localhost:3000
